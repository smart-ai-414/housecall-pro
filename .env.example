# ---------------------------------------------------------------------------
# GlassBot environment
# Copy to .env and fill in. Never commit real values.
# Generate every secret below with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Port the dev server and production server listen on. Read by
# scripts/next-with-env.mjs, because Next resolves its port before it loads
# .env files and would otherwise ignore this.
PORT="3000"

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glassbot?schema=public"
# Only needed when DATABASE_URL points at a connection pooler. Migrations
# require a direct connection.
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glassbot?schema=public"

# --- Auth (NextAuth / Auth.js v5) ------------------------------------------
# Signs the JWT session cookie. Rotating this logs everyone out.
AUTH_SECRET="replace-me-openssl-rand-base64-32"
# Canonical origin. REQUIRED IN PRODUCTION so callback URLs are not inferred
# from a forwarded header an attacker can set.
# Leave this unset in local development: Auth.js then infers the origin from the
# request, so changing PORT above just works. If you do set it, it must match
# PORT exactly or sign-in will redirect to a port nothing is listening on.
# AUTH_URL="https://estimates.example.com"
# Set to true only behind a trusted proxy that sets X-Forwarded-Host (e.g. Vercel).
AUTH_TRUST_HOST="true"

# --- Encryption at rest ----------------------------------------------------
# AES-256-GCM key for Housecall Pro API keys. MUST be 32 bytes, base64-encoded.
# Losing this makes every stored API key unrecoverable; rotating it requires
# re-entering each location's key.
ENCRYPTION_KEY="replace-me-32-byte-base64-key"

# --- Session resume tokens -------------------------------------------------
# HMAC key for customer resume links. Separate from AUTH_SECRET so a leaked
# resume link cannot be escalated into a staff session.
RESUME_TOKEN_SECRET="replace-me-openssl-rand-base64-32"

# --- Perception (vision) — Phase 2 -----------------------------------------
# Paid per call. The public intake endpoint is a cost-attack surface, which is
# why rate limiting is enforced before any call is made.
#
# Gemini is the primary provider, per the implementation plan: the client
# already holds this key and uses it elsewhere in their business.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Anthropic is registered as an alternative provider. Only needed if a function
# below is routed to it.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Which provider answers which question. Omit for Gemini everywhere. A per
# function variable overrides the blanket one, so dimension estimation can be
# escalated to a stronger model without touching any code.
#   PERCEPTION_PROVIDER="gemini"
#   PERCEPTION_PROVIDER_CLASSIFY="gemini"
#   PERCEPTION_PROVIDER_DIMENSIONS="anthropic"
#   PERCEPTION_PROVIDER_PHOTO_QUALITY="gemini"
#
# Run `npm run perception:probe` from the machine that will serve the app to
# find out which providers are actually reachable from its IP.

# Below this confidence a job skips pricing entirely and lands in Housecall Pro
# as an unpriced callback lead. 0.6 is a starting point, not a measured value —
# run `npm run accuracy` once 30 or more real submissions have been reviewed and
# set this from the calibration table it prints.
PERCEPTION_CONFIDENCE_THRESHOLD="0.6"
# Each run is a paid call on a public endpoint. A session gets this many, which
# covers the first two photos plus a conditional corner close-up.
PERCEPTION_MAX_RUNS_PER_SESSION="3"

# --- Housecall Pro — Phase 2 ----------------------------------------------
# NO test environment exists. All writes hit the live account. Anything created
# from a dev machine must carry the [TEST] prefix.
#
# This value must include any version prefix the account's API expects, because
# the module paths are bare ("customers", "estimates"). If the API answers on
# https://api.housecallpro.com/pro/v1/customers then this must end in /pro/v1.
# Run `npm run hcp:smoke` — it probes the candidates and prints which one works.
HOUSECALL_PRO_API_BASE_URL="https://api.housecallpro.com"
# Per-location keys are stored encrypted in the database, not here. This is only
# a fallback for local scripts.
HOUSECALL_PRO_API_KEY=""
# Set to "true" ONLY on the real production deployment. Anywhere else, records
# written to the live account carry the [TEST] prefix and the guard refuses to
# modify anything that is not already a test record. This is deliberately an
# explicit opt-in rather than a NODE_ENV check: a preview or staging deploy
# builds with NODE_ENV=production and would otherwise write unmarked records
# into the live account alongside real customers.
HOUSECALL_PRO_LIVE_WRITES="false"
# Tags customers created by the widget so their volume is measurable in
# Housecall Pro's own reporting. Housecall Pro validates this against the
# lead sources configured in the account, so leave it blank until someone
# has added a matching one under Settings. Blank omits the field entirely.
HOUSECALL_PRO_LEAD_SOURCE=""

# --- Public application URL ------------------------------------------------
# Absolute origin this app is reachable at. Photo links written into Housecall
# Pro estimate notes are built from it, and they must still work when a
# reviewer opens the estimate days later. A raw signed storage URL cannot:
# SigV4 caps presigned URLs at 7 days, and ours are minted for 15 minutes.
# Falls back to AUTH_URL. If neither is set, notes carry short-lived signed
# links and say so.
PUBLIC_APP_URL=""

# --- Photo storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) -----------
# Photos upload direct-to-storage via signed URLs and never transit this server.
STORAGE_BUCKET="glassbot-photos"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Required for R2/MinIO; leave blank for AWS S3.
STORAGE_ENDPOINT=""
# Public base URL used to read stored objects back.
STORAGE_PUBLIC_BASE_URL=""

# --- Bot protection (Cloudflare Turnstile) ---------------------------------
# Both must be set for Turnstile to run. With either blank the widget skips the
# challenge entirely and the honeypot plus fill-time checks in
# core/security/request-guard.ts carry the load on their own.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Rate limiting ---------------------------------------------------------
# Sessions one IP may start per rolling 24h window before it is blocked.
RATE_LIMIT_SESSIONS_PER_DAY="5"
# Minimum seconds between two session starts from the same IP.
RATE_LIMIT_MIN_SECONDS_BETWEEN_SESSIONS="30"

# --- Abandonment sweep -----------------------------------------------------
# Bearer token for /api/cron/abandonment-sweep. The sweep writes partial leads
# to the live Housecall Pro account, so it refuses to run without this set.
CRON_SECRET=""

# --- Seed data (optional, development only) --------------------------------
# SEED_ADMIN_EMAIL="admin@clearviewglass.example"
# SEED_ADMIN_PASSWORD="change-me-locally"
# SEED_ADMIN_NAME="Dev Administrator"
