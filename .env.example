# ---------------------------------------------------------------------------
# GlassBot environment
# Copy to .env and fill in. Never commit real values.
# Generate every secret below with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Port the dev server and production server listen on. Read by
# scripts/next-with-env.mjs, because Next resolves its port before it loads
# .env files and would otherwise ignore this.
PORT="3000"

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glassbot?schema=public"
# Only needed when DATABASE_URL points at a connection pooler. Migrations
# require a direct connection.
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glassbot?schema=public"

# --- Auth (NextAuth / Auth.js v5) ------------------------------------------
# Signs the JWT session cookie. Rotating this logs everyone out.
AUTH_SECRET="replace-me-openssl-rand-base64-32"
# Canonical origin. REQUIRED IN PRODUCTION so callback URLs are not inferred
# from a forwarded header an attacker can set.
# Leave this unset in local development: Auth.js then infers the origin from the
# request, so changing PORT above just works. If you do set it, it must match
# PORT exactly or sign-in will redirect to a port nothing is listening on.
# AUTH_URL="https://estimates.example.com"
# Set to true only behind a trusted proxy that sets X-Forwarded-Host (e.g. Vercel).
AUTH_TRUST_HOST="true"

# --- Encryption at rest ----------------------------------------------------
# AES-256-GCM key for Housecall Pro API keys. MUST be 32 bytes, base64-encoded.
# Losing this makes every stored API key unrecoverable; rotating it requires
# re-entering each location's key.
ENCRYPTION_KEY="replace-me-32-byte-base64-key"

# --- Session resume tokens -------------------------------------------------
# HMAC key for customer resume links. Separate from AUTH_SECRET so a leaked
# resume link cannot be escalated into a staff session.
RESUME_TOKEN_SECRET="replace-me-openssl-rand-base64-32"

# --- Claude (Anthropic) — Phase 3 ------------------------------------------
# Paid per call. The public intake endpoint is a cost-attack surface, which is
# why rate limiting is enforced before any call is made.
ANTHROPIC_API_KEY=""

# --- Housecall Pro — Phase 2 ----------------------------------------------
# NO test environment exists. All writes hit the live account. Anything created
# from a dev machine must carry the [TEST] prefix.
HOUSECALL_PRO_API_BASE_URL="https://api.housecallpro.com"
# Per-location keys are stored encrypted in the database, not here. This is only
# a fallback for local scripts.
HOUSECALL_PRO_API_KEY=""

# --- Photo storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) -----------
# Photos upload direct-to-storage via signed URLs and never transit this server.
STORAGE_BUCKET="glassbot-photos"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Required for R2/MinIO; leave blank for AWS S3.
STORAGE_ENDPOINT=""
# Public base URL used to read stored objects back.
STORAGE_PUBLIC_BASE_URL=""

# --- Rate limiting ---------------------------------------------------------
# Sessions one IP may start per rolling 24h window before it is blocked.
RATE_LIMIT_SESSIONS_PER_DAY="5"
# Minimum seconds between two session starts from the same IP.
RATE_LIMIT_MIN_SECONDS_BETWEEN_SESSIONS="30"

# --- Abandonment sweep -----------------------------------------------------
# Bearer token for /api/cron/abandonment-sweep. The sweep writes partial leads
# to the live Housecall Pro account, so it refuses to run without this set.
CRON_SECRET=""

# --- Seed data (optional, development only) --------------------------------
# SEED_ADMIN_EMAIL="admin@clearviewglass.example"
# SEED_ADMIN_PASSWORD="change-me-locally"
# SEED_ADMIN_NAME="Dev Administrator"
